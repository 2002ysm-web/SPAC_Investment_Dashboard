import os
import json
import requests
from datetime import datetime, timezone, timedelta

KRX_KOSDAQ_BASE_URL = "https://openapi.krx.co.kr/svc/apis/sto/ksq_bydd_trd"
KRX_API_KEY = os.getenv("KRX_API_KEY", "")


def is_spac_department(dept_value: str) -> bool:
    """KRX 코스닥 종목 정보의 '소속부'가 SPAC인지 판별 (종목명 기준 필터링 미사용)"""
    if not dept_value:
        return False
    normalized = dept_value.strip().upper().replace(" ", "")
    return normalized in {"SPAC", "SPAC(기업인수목적회사)", "기업인수목적회사"} or "SPAC" in normalized


def fetch_krx_kosdaq_stocks(bas_dd: str) -> list[dict]:
    """KRX Open API에서 기준일자(YYYYMMDD) 코스닥 종목 목록 조회"""
    if not KRX_API_KEY:
        return []
    headers = {
        "AUTH_KEY": KRX_API_KEY,
        "Accept": "application/json",
    }
    params = {"basDd": bas_dd}
    resp = requests.get(KRX_KOSDAQ_BASE_URL, headers=headers, params=params, timeout=15)
    resp.raise_for_status()
    data = resp.json()
    if isinstance(data, dict):
        return data.get("OutBlock_1") or data.get("output") or data.get("items") or []
    return data if isinstance(data, list) else []


def sync_spac_items(existing_items: list[dict], krx_rows: list[dict]) -> list[dict]:
    """
    1) 기존 종목 중 KRX 코스닥 소속부가 SPAC이 아닌 종목 제외
    2) KRX 코스닥 소속부가 SPAC인 신규 상장 종목을 동일 로직으로 자동 추가
    """
    krx_by_code = {}
    spac_dept_codes = set()

    for row in krx_rows:
        code = str(row.get("ISU_SRT_CD") or row.get("code") or "").strip()
        name = str(row.get("ISU_ABBRV") or row.get("ISU_NM") or row.get("name") or "").strip()
        dept = str(
            row.get("MKT_TP_NM")
            or row.get("DEPT_NM")
            or row.get("소속부")
            or row.get("dept")
            or ""
        ).strip()
        price_raw = (
            str(row.get("TDD_CLSPRC") or row.get("CLSPRC") or row.get("current_price") or "0")
            .replace(",", "")
            .strip()
        )
        try:
            current_price = float(price_raw) if price_raw else 0
        except ValueError:
            current_price = 0

        if not code:
            continue

        krx_by_code[code] = {
            "code": code,
            "name": name,
            "dept": dept,
            "current_price": current_price,
        }
        if is_spac_department(dept):
            spac_dept_codes.add(code)

    result = []
    seen_codes = set()

    for item in existing_items:
        code = str(item.get("code") or "").strip()
        if krx_by_code:
            if code not in spac_dept_codes:
                continue
            krx_info = krx_by_code[code]
            result.append({
                **item,
                "name": krx_info["name"] or item.get("name", ""),
                "dept": krx_info["dept"] or "SPAC",
                "current_price": krx_info["current_price"] if krx_info["current_price"] else item.get("current_price", 0),
            })
            seen_codes.add(code)
        else:
            if "dept" in item and not is_spac_department(str(item.get("dept", ""))):
                continue
            result.append(item)
            if code:
                seen_codes.add(code)

    today_str = datetime.now(timezone(timedelta(hours=9))).strftime("%Y-%m-%d")
    for code in spac_dept_codes:
        if code in seen_codes:
            continue
        info = krx_by_code[code]
        result.append({
            "code": code,
            "name": info["name"],
            "dept": info["dept"] or "SPAC",
            "listing_date": today_str,
            "delisting_date": "",
            "remaining_days": None,
            "corp_code": "",
            "base_price": 2000,
            "current_price": info["current_price"],
            "liquidation_price": 2118.42,
            "liquidation_price_source": "추정공모가(2,000원)+복리+최종6개월산식",
            "fair_buy_price": None,
            "is_fair_buy": "O",
            "invest_type": "청산",
            "yield_isa": None,
            "yield_general": None,
            "deposit_rate": 2.4,
            "is_suspended": False,
            "has_liquidation_notice": False,
            "status": "일반",
            "recent_disclosures": [],
        })
        seen_codes.add(code)

    return result


def main():
    kst = timezone(timedelta(hours=9))
    now_kst = datetime.now(kst)
    bas_dd = now_kst.strftime("%Y%m%d")

    existing_payload = {"items": []}
    if os.path.exists("spacs.json"):
        with open("spacs.json", "r", encoding="utf-8") as f:
            existing_payload = json.load(f)

    existing_items = (
        existing_payload.get("items")
        if isinstance(existing_payload, dict)
        else existing_payload
    )
    krx_rows = fetch_krx_kosdaq_stocks(bas_dd)
    merged_items = sync_spac_items(existing_items or [], krx_rows)

    output = {
        "updated_at": now_kst.strftime("%Y-%m-%d %H:%M:%S KST"),
        "count": len(merged_items),
        "items": merged_items,
    }
    with open("spacs.json", "w", encoding="utf-8") as f:
        json.dump(output, f, ensure_ascii=False, indent=2)


if __name__ == "__main__":
    main()
